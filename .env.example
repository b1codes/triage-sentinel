# Copy to .env (gitignored) and fill in. chmod 600 .env.
# Only DASHBOARD_PASSWORD_HASH is required for M0; the rest are validated
# for format when set and asserted present by the milestone that uses them.

# Dashboard login. Generate with:
#   go run ./cmd/sentinel hash-password
DASHBOARD_PASSWORD_HASH=

# LLM access (required from M2)
ANTHROPIC_API_KEY=

# GitHub delivery and webhook verification (required from M1)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# GCP ingestion (required from M1)
GCP_PROJECT_ID=
PUBSUB_SUBSCRIPTION=
GOOGLE_APPLICATION_CREDENTIALS=

# Escalation (optional)
SLACK_WEBHOOK_URL=

# Runtime
SENTINEL_LISTEN_ADDR=127.0.0.1:8787
SENTINEL_DATA_DIR=./var
SENTINEL_TIMEZONE=UTC
SENTINEL_LOG_LEVEL=info
