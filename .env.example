# Copy to .env (gitignored) and fill in. chmod 600 .env.
# Only DASHBOARD_PASSWORD_HASH is required for M0; the rest are validated
# for format when set and asserted present by the milestone that uses them.

# Dashboard login. Generate with:
#   go run ./cmd/sentinel hash-password
DASHBOARD_PASSWORD_HASH=

# LLM access (required from M2)
ANTHROPIC_API_KEY=

# GitHub delivery and webhook verification (required from M1).
# All four ingestion variables below are asserted at startup; the binary
# refuses to serve without them. Pass --no-ingest for dashboard-only local
# work.
#
# GITHUB_TOKEN needs read scope only in M1: job-level fingerprinting reads the
# Actions API, because the workflow_run webhook payload carries the run but not
# its failing job and step. M4 is the first milestone that needs write.
GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET is shared with the Cloud Run relay via Secret Manager.
# The control plane independently re-verifies every forwarded signature, so a
# compromised relay cannot inject events.
GITHUB_WEBHOOK_SECRET=

# GCP ingestion (required from M1). Application default credentials must carry
# roles/pubsub.subscriber; nothing more, because deploy/gcp/ creates the sinks.
GCP_PROJECT_ID=
# Fully qualified: projects/<project>/subscriptions/<name>
PUBSUB_SUBSCRIPTION=
GOOGLE_APPLICATION_CREDENTIALS=

# Escalation (optional)
SLACK_WEBHOOK_URL=

# Runtime
SENTINEL_LISTEN_ADDR=127.0.0.1:8787
SENTINEL_DATA_DIR=./var
SENTINEL_TIMEZONE=UTC
SENTINEL_LOG_LEVEL=info
